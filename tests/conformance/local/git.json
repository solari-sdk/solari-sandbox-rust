    {
      "id": "log-keeps-subject-and-body",
      "op": "git.log",
      "input": {
        "cwd": "/repo",
        "maxCount": 2
      },
      "why": "records end with \\x1e, fields with \\x1f: a multi-line body is part of its commit; message = subject, body = the rest",
      "mock": [
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes",
            "body": {
              "template": "base"
            }
          },
          "reply": {
            "status": 201,
            "body": {
              "sandboxId": "pool-a:vm-7:org-42.sig",
              "kind": "sandbox",
              "state": "running",
              "controlUrl": "$MOCK_WS/control/pool-a%3Avm-7%3Aorg-42.sig",
              "expiresAt": "2030-01-01T00:00:00Z"
            }
          }
        },
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes/pool-a%3Avm-7%3Aorg-42.sig/exec",
            "headers": {
              "authorization": "Bearer conformance-test-key",
              "accept": "application/json",
              "content-type": "application/json"
            },
            "body": {
              "cmd": "git",
              "args": [
                "log",
                "--format=%H%x1f%an%x1f%ae%x1f%aI%x1f%s%x1f%b%x1e",
                "--max-count=2"
              ],
              "cwd": "/repo"
            }
          },
          "reply": {
            "status": 200,
            "body": {
              "exitCode": 0,
              "stdout": "h1\u001fAda\u001fada@x\u001f2026-01-01T00:00:00+00:00\u001ffirst\u001fbody 1\nline 2\n\u001e\nh2\u001fLin\u001flin@x\u001f2026-01-02T00:00:00+00:00\u001fsecond\u001f\n\u001e\n",
              "stderr": "",
              "timedOut": false,
              "oomKilled": false
            }
          }
        }
      ],
      "expect": {
        "result": {
          "list": [
            {
              "hash": "h1",
              "author": "Ada",
              "email": "ada@x",
              "message": "first",
              "body": "body 1\nline 2"
            },
            {
              "hash": "h2",
              "author": "Lin",
              "email": "lin@x",
              "message": "second",
              "body": ""
            }
          ]
        },
        "requests": 2
      }
    },
