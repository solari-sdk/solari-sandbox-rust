{
  "comment": "git.status / branches / log: the exact git invocation and how its output is parsed (audit retest: parsing was lossy in every SDK). The SDK runs `git` through commands.run (REST /exec here); the rows script git's stdout.",
  "git": [
    {
      "id": "status-verbatim-paths-rename-conflict-untracked",
      "op": "git.status",
      "input": {
        "cwd": "/repo"
      },
      "why": "git status is requested with -z (verbatim paths) and --untracked-files=all; spaces/non-ASCII are NOT quoted, a rename is the new path with origPath, a conflict is listed once as conflicted, an untracked directory lists its files",
      "mock": [
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes",
            "body": {
              "template": "base"
            }
          },
          "reply": {
            "status": 201,
            "body": {
              "sandboxId": "pool-a:vm-7:org-42.sig",
              "kind": "sandbox",
              "state": "running",
              "controlUrl": "$MOCK_WS/control/pool-a%3Avm-7%3Aorg-42.sig",
              "expiresAt": "2030-01-01T00:00:00Z"
            }
          }
        },
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes/pool-a%3Avm-7%3Aorg-42.sig/exec",
            "headers": {
              "authorization": "Bearer conformance-test-key",
              "accept": "application/json",
              "content-type": "application/json"
            },
            "body": {
              "cmd": "git",
              "args": [
                "status",
                "--porcelain=v1",
                "-z",
                "--branch",
                "--untracked-files=all"
              ],
              "cwd": "/repo"
            }
          },
          "reply": {
            "status": 200,
            "body": {
              "exitCode": 0,
              "stdout": "## main...origin/main [ahead 1, behind 2]\u0000 M a b.txt\u0000R  new name\u0000old name\u0000UU conflict\u0000A  é ü.txt\u0000?? nd/inner\u0000?? nd/deep file\u0000",
              "stderr": "",
              "timedOut": false,
              "oomKilled": false
            }
          }
        }
      ],
      "expect": {
        "result": {
          "branch": "main",
          "upstream": "origin/main",
          "ahead": 1,
          "behind": 2,
          "detached": false,
          "staged": [
            "new name",
            "é ü.txt"
          ],
          "modified": [
            "a b.txt"
          ],
          "conflicted": [
            "conflict"
          ],
          "untracked": [
            "nd/inner",
            "nd/deep file"
          ],
          "clean": false,
          "entries": [
            {
              "path": "a b.txt",
              "index": " ",
              "worktree": "M"
            },
            {
              "path": "new name",
              "origPath": "old name",
              "index": "R",
              "worktree": " "
            },
            {
              "path": "conflict",
              "index": "U",
              "worktree": "U"
            },
            {
              "path": "é ü.txt",
              "index": "A",
              "worktree": " "
            },
            {
              "path": "nd/inner",
              "index": "?",
              "worktree": "?"
            },
            {
              "path": "nd/deep file",
              "index": "?",
              "worktree": "?"
            }
          ]
        },
        "requests": 2
      }
    },
