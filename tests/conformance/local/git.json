    {
      "id": "branches-real-branches-only",
      "op": "git.branches",
      "input": {
        "cwd": "/repo"
      },
      "why": "for-each-ref refs/heads lists real branches only (a detached HEAD is not a branch; none is current); upstream is reported",
      "mock": [
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes",
            "body": {
              "template": "base"
            }
          },
          "reply": {
            "status": 201,
            "body": {
              "sandboxId": "pool-a:vm-7:org-42.sig",
              "kind": "sandbox",
              "state": "running",
              "controlUrl": "$MOCK_WS/control/pool-a%3Avm-7%3Aorg-42.sig",
              "expiresAt": "2030-01-01T00:00:00Z"
            }
          }
        },
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes/pool-a%3Avm-7%3Aorg-42.sig/exec",
            "headers": {
              "authorization": "Bearer conformance-test-key",
              "accept": "application/json",
              "content-type": "application/json"
            },
            "body": {
              "cmd": "git",
              "args": [
                "for-each-ref",
                "--format=%(HEAD)%1f%(refname:short)%1f%(objectname:short)%1f%(upstream:short)",
                "refs/heads"
              ],
              "cwd": "/repo"
            }
          },
          "reply": {
            "status": 200,
            "body": {
              "exitCode": 0,
              "stdout": " \u001ffeat/x\u001fabc1234\u001f\n \u001fmain\u001fdef5678\u001forigin/main\n",
              "stderr": "",
              "timedOut": false,
              "oomKilled": false
            }
          }
        }
      ],
      "expect": {
        "result": {
          "list": [
            {
              "name": "feat/x",
              "commit": "abc1234",
              "current": false
            },
            {
              "name": "main",
              "commit": "def5678",
              "current": false,
              "upstream": "origin/main"
            }
          ]
        },
        "requests": 2
      }
    },
