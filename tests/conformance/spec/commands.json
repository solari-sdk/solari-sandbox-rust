{
  "comment": "commands.run over the two transports (REST /exec and the control WebSocket) must be indistinguishable: ~/reports/x2/spec.md. Each scenario has a -rest row (no channel, no env: the SDK uses /exec) and a -ws row (env set: the SDK uses cmd.start over the scripted control socket) with the SAME expect. via is the transport the adapter forces.",
  "commands": [
    {
      "id": "run-ok-rest",
      "op": "commands.run",
      "why": "plain success: all four result fields",
      "input": {
        "via": "rest",
        "cmd": "echo",
        "args": [
          "hi"
        ],
        "timeoutMs": 5000
      },
      "mock": [
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes",
            "body": {
              "template": "base"
            }
          },
          "reply": {
            "status": 201,
            "body": {
              "sandboxId": "pool-a:vm-7:org-42.sig",
              "kind": "sandbox",
              "state": "running",
              "controlUrl": "$MOCK_WS/control/pool-a%3Avm-7%3Aorg-42.sig",
              "expiresAt": "2030-01-01T00:00:00Z"
            }
          }
        },
        {
          "expect": {
            "method": "POST",
            "path": "/sandboxes/pool-a%3Avm-7%3Aorg-42.sig/exec",
            "headers": {
              "authorization": "Bearer conformance-test-key",
              "accept": "application/json",
              "content-type": "application/json"
            },
            "body": {
              "cmd": "echo",
              "args": [
                "hi"
              ],
              "timeoutMs": 5000
            }
          },
          "reply": {
            "status": 200,
            "body": {
              "exitCode": 0,
              "stdout": "hi\n",
              "stderr": "",
              "timedOut": false
            }
          }
        }
      ],
      "expect": {
        "result": {
          "exitCode": 0,
          "stdout": "hi\n",
          "stderr": "",
          "timedOut": false,
          "oomKilled": false
        }
      }
    },
    {
