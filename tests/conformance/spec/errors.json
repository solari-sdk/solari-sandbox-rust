      "input": {
        "id": "pool-a:vm-7:org-42.sig"
      },
      "mock": [
        {
          "expect": {
            "method": "GET",
            "path": "/sandboxes/pool-a%3Avm-7%3Aorg-42.sig",
            "headers": {
              "authorization": "Bearer conformance-test-key"
            }
          },
          "reply": "gateway:unauthorized-401"
        }
      ],
      "expect": {
        "error": {
          "type": "auth",
          "status": 401,
          "code": "Unauthorized"
        },
        "requests": 1
      }
